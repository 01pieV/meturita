import tkinter as tk
import random
win = tk.Tk()
canvas = tk.Canvas(win, width=300, height=300)
canvas.pack()

fr = open('ciarovy_kod_1.txt',"r")

kody = []
p = []

for ii in range(8):
    p.append(random.randint(1,9))

for line in fr:
    line = line.strip()
    kody.append(line)
print(kody)
print(p)
x = 10
y = 100
y_s = 20
def kod(line):
    global x,y,y_s
    prvy = int(line[0])
    posledny = int(line[-1])
    temp = line[1:-1]
    canvas.create_line(x,y,x,y_s,fill="black", width=prvy)
    canvas.create_text(x+35,y-5,text=line,font=("Arial",7),fill="black")
    x += 10
    for i in range(len(temp)):
        if int(temp[i]) != 0:
            canvas.create_line(x,y-10,x,y_s,fill="black",width=temp[i])
            x += 10
        else:
            x +=10
    canvas.create_line(x, y, x, y_s, fill="black", width=posledny)
    x += 10

kod(p)
cislo = 0
def ciarove(event=None):
    global x,y,y_s,cislo
    canvas.delete("all")
    if cislo < len(kody):
        x,y,y_s = 10,100,20
        kod(kody[cislo])
    if cislo+1 < len(kody):
        x,y,y_s = 100,100,20
        kod(kody[cislo+1])
    if cislo+2 < len(kody):
        x,y,y_s = 10,300,220
        kod(kody[cislo+2])
    if cislo++3 < len(kody):
        x,y,y_s = 100,300,220
        kod(kody[cislo+3])
    cislo += 4

win.bind("<space>", ciarove)

win.mainloop()
