fr = open('ucenie_sa_slovicok.txt',"r")
slov = []
anglicke = []

slova = fr.readlines()

for s in range(0,len(slova),2):
   slov.append(slova[s].strip())
   anglicke.append(slova[s+1].strip())

mode = input("s/a: ")

if mode == "s":
    nesp = 0
    temp = []
    temp_a = []
    while len(slov) > 0:
        for sl in slov:
            print(sl)
            odpoved = input()
            index = slov.index(sl)
            if odpoved != anglicke[index]:
                print("nespravne")
                nesp += 1
            elif odpoved == anglicke[index]:
                print("spravne")
                if sl in slov:
                    temp.append(sl)
                    temp_a.append(anglicke[index])
        for h in temp:
            inx = slov.index(h)
            slov.remove(h)
            anglicke.remove(anglicke[inx])
        temp = []
        temp_a = []

    print()
    print(f"vyhral si - {nesp} nesprávne")

