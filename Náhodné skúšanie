import random
po = int(input())
ps = int(input())

studenti = []
otazky = []
prane = []
neparne = []

for i in range(1,po+1):
    otazky.append(i)
    if i %2 == 0:
        prane.append(i)
    else:
        neparne.append(i)
for a in range(1,ps+1):
    studenti.append(a)

if po<ps:
    print("malo otazok")
else:
    random.shuffle(studenti)
    random.shuffle(otazky)
    random.shuffle(prane)
    random.shuffle(neparne)
    nove_o = []
    for i in range(ps):
        if i %2 == 0:
            nove_o.append(prane.pop(0))
        else:
            nove_o.append(neparne.pop(0))
    otazky = nove_o
    for j in range(ps):
        print(f"{j+1}.študent - {studenti[j]} - otázka {otazky[j]}")
