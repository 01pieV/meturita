import tkinter as tk
import random
win = tk.Tk()
canvas = tk.Canvas(win,height=200,width=500, bg="white")
canvas.pack()

canvas.create_text(250,20,text="Pyrotechnik",fill="blue",font=("Times New Roman",20))
canvas.create_text(250,40,text="označ správny kábel",fill="grey",font=("Times New Roman",10))

farby = ["green","red","grey","blue","yellow"]

ciary = []
x = 50
y = 60
for i in range(5):
    id = canvas.create_line(x,y,x+300,y,fill=farby[i],width=10)
    y += 10
    ciary.append(id)

vyhra = random.choice(ciary)
print(vyhra)

cas = 60
hra = True
cas_text = canvas.create_text(350,150,text = cas)

def odpocitaj():
    global cas, hra
    if hra:
        canvas.itemconfig(cas_text,text = cas,font=("Times New Roman",30))
        if cas == 0:
            canvas.delete(cas_text)
            hra = False
            canvas.create_text(350,150,text = "koniec",font=("Times New Roman",20))
        else:
            cas -= 1
            canvas.after(1000,odpocitaj)

def klik(event):
    global hra
    if not hra:
        return
    obj = canvas.find_withtag("current")[0]
    if obj == vyhra:
        canvas.create_text(350,180,text="vyhral si!",fill="red",font=("Times New Roman",30))
        hra = False


canvas.bind("<Button-1>",klik)
odpocitaj()
win.mainloop()
