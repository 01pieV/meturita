import tkinter as tk
import random
win = tk.Tk()
canvas = tk.Canvas(win, width=500, height=300)
canvas.pack()

farby = ["green","red","grey","blue","yellow"]
canvas.create_text(250,30,text= "Pyrotechnik",fill="blue",font=("Arial",30))
canvas.create_text(250,60,text= "vyber správny káblik",fill="grey",font=("Arial",10,"bold"))

kable = []
x = 50
y = 100
for i in range(5):
    tag = i+1
    canvas.create_line(x,y+5,x+300,y+5,width=10,fill=farby[i],tags=tag)
    y+=10
    kable.append(tag)
vyh = random.choice(kable)
print(vyh)

cas = 60
hra = True
c = canvas.create_text(400,200,text=cas,font=("Arial",30))
def zmena_c():
    global cas,hra
    if hra:
        if cas == 0:
            canvas.delete(c)
            canvas.create_text(400,200,text="BUM!",font=("Arial",30))
            hra = False
            return
        else:
            cas -= 1
            canvas.itemconfig(c,text=cas)
            canvas.after(1000,zmena_c)
zmena_c()

def klik(event):
    global hra
    if not hra:
        return
    obj = canvas.find_withtag("current")[0]
    if obj:
        kab = canvas.gettags(obj)[0]
        if vyh == int(kab):
            canvas.create_text(250, 200, text="správne!!", font=("Arial", 30))
            hra = False
        else:
            canvas.create_text(250, 200, text="nesprávne!!", font=("Arial", 30))
            hra = False

canvas.bind("<Button-1>",klik)
win.mainloop()
