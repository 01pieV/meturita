fr = open("hlasovanie_1.txt", "r")
hlasy = fr.readlines()

pocet = len(hlasy)
print(pocet)

h = {}

for a in range(10):
    h[str(5220+a)] = 0

for i in hlasy:
    i = i.strip()
    if i in h:
        h[i] += 1

h = dict(sorted(h.items()))

def najhorsi():
    naj = 100000000000000
    mena = []
    for b,n in h.items():
        if n < naj:
            naj = n

    for c,v in h.items():
        if v == naj:
            mena.append(c)
    for m in mena:
        h.pop(m)
    return mena

print(h)
print(najhorsi())
print(h)
print(najhorsi())
print(h)
