import tkinter, random

canvas = tkinter.Canvas(width=700, height=800)
canvas.pack()

def lodicka(x, y):
    plachta = random.randint(-3, 3)
    canvas.create_line(x, y, x, y - 25, x + 10 + plachta, y - 10, x, y - 5)
    canvas.create_polygon(x - 20, y, x + 20, y, x + 10, y + 8, x - 10, y + 8)

x = [30]*15
y = 50
for z in range(15):
    lodicka(30, y)
    canvas.create_line(650,0,650,800,fill="red",width=2)
    y += 50

def preteky(event):
    hra = True
    while hra:
        canvas.delete("all")
        canvas.create_line(650, 0, 650, 800, fill="red", width=2)
        yy = 50
        for i in range(15):
            x[i] += random.randint(1, 10)
            lodicka(x[i], yy)
            yy += 50
            if x[i] >= 650:
                hra = False
                vit = i+1
        canvas.update()
        canvas.after(20)
    canvas.create_text(350,400,text=f"vyhrala lodička: {str(vit)}",font=("Arial",30))
canvas.bind_all("<Button-1>", preteky)

canvas.mainloop()
